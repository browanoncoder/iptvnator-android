{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [
            "ES2021",
            "DOM",
            "DOM.Iterable"
        ],
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "noEmit": true,
        "baseUrl": ".",
        "paths": {
            "@iptvnator/shared/interfaces": [
                "../../iptvnator/libs/shared/interfaces/src/index.ts"
            ]
        },
        "noImplicitAny": false
    },
    "include": [
        "src"
    ]
}