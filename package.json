{
  "name": "iptvnator-android",
  "private": true,
  "version": "0.1.0",
  "description": "Experimental Capacitor wrapper of the IPTVnator TV client for Android TV",
  "scripts": {
    "build:shell": "esbuild shell/src/main.ts --bundle --format=iife --target=chrome80 --minify --outfile=build/shell.js",
    "sync:web": "npm run build:shell && node shell/prepare-web.mjs",
    "sync": "npm run sync:web && cap sync android",
    "build:apk": "npm run sync && cd android && ./gradlew assembleDebug -q",
    "typecheck": "tsc -p shell/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "esbuild": "0.25.12",
    "iptv-playlist-parser": "github:4gray/iptv-playlist-parser#v0.15.2-iptvnator.2",
    "typescript": "5.8.3"
  }
}